# ════════════════════════════════════════════════════════
# Lumora AI Backend — Environment Variables
# Copy to .env for local dev. Set in Render dashboard for prod.
# ════════════════════════════════════════════════════════

# ── App ──────────────────────────────────────────────────
ENVIRONMENT=development
DEBUG=true
APP_NAME=Lumora AI
SECRET_KEY=your-64-char-random-secret-here
JWT_SECRET_KEY=your-64-char-jwt-secret-here

# ── Neon PostgreSQL ──────────────────────────────────────
# Get from: console.neon.tech → Your Project → Connection String
# Format:   postgresql+asyncpg://user:pass@ep-xxx.neon.tech/dbname?sslmode=require
DATABASE_URL=postgresql+asyncpg://user:pass@ep-xxxx-xxxx.us-east-2.aws.neon.tech/dbname?sslmode=require

# ── Upstash Redis (free, no sleep) ──────────────────────
# Get from: console.upstash.com → Create Database → Redis → .env tab
REDIS_URL=rediss://default:your-token@your-endpoint.upstash.io:6379

# ── AI Provider ──────────────────────────────────────────
LLM_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.0-flash

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ── CORS ─────────────────────────────────────────────────
# Local dev: http://localhost:3000
# Production: https://lumora-ai-frontend.onrender.com
CORS_ORIGINS=http://localhost:3000

# ── JWT ──────────────────────────────────────────────────
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ── Vector Store ─────────────────────────────────────────
# Use pgvector on Neon for persistence
# Use /tmp/vector_store as FAISS fallback only
VECTOR_STORE_PATH=/tmp/vector_store

