# Copy to .env for local dev. Set in Render dashboard for production.

ENVIRONMENT=production
DEBUG=false
APP_NAME=Lumora AI
SECRET_KEY=REPLACE_WITH_64_CHAR_RANDOM_STRING
JWT_SECRET_KEY=REPLACE_WITH_ANOTHER_64_CHAR_RANDOM_STRING

# Neon PostgreSQL — get from console.neon.tech
# Format: postgresql+asyncpg://user:pass@ep-xxxx.neon.tech/dbname?ssl=require
DATABASE_URL=postgresql+asyncpg://user:pass@ep-xxxx.neon.tech/dbname?ssl=require

# Upstash Redis — get from console.upstash.com
REDIS_URL=rediss://default:token@endpoint.upstash.io:6379

# Gemini — get from aistudio.google.com/app/apikey
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_key_here
GEMINI_MODEL=gemini-2.0-flash

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Set to your frontend URL after deploying
CORS_ORIGINS=https://lumora-ai-frontend.onrender.com

JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
VECTOR_STORE_PATH=/tmp/vector_store
