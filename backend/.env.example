# ═══════════════════════════════════════════════════════
# Lumora AI Backend — Environment Variables
# Copy this file to .env and fill in your values
# ═══════════════════════════════════════════════════════

# ── App ──────────────────────────────────────────────────
APP_NAME=Lumora AI
APP_VERSION=1.0.0
ENVIRONMENT=production
DEBUG=false
SECRET_KEY=CHANGE_ME_64_CHAR_RANDOM_STRING_HERE

# ── CORS ─────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
# Example: https://lumora-ai.onrender.com,https://lumora-ai.vercel.app
CORS_ORIGINS=https://your-frontend-url.onrender.com

# ── AI Provider ──────────────────────────────────────────
# Set llm_provider to "gemini" (free) or "openai" (paid)
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=2000
OPENAI_TEMPERATURE=0.7

# ── Database ─────────────────────────────────────────────
# Render provides this as: postgres://user:pass@host/dbname
# Our config auto-converts postgres:// to postgresql+asyncpg://
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/dbname

# ── Redis ────────────────────────────────────────────────
# Render/Railway provide redis:// URLs
REDIS_URL=redis://default:password@host:6379/0

# ── Authentication ───────────────────────────────────────
JWT_SECRET_KEY=CHANGE_ME_ANOTHER_64_CHAR_RANDOM_STRING
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ── LangSmith (optional) ─────────────────────────────────
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=lumora-ai-prod

# ── Rate Limiting ────────────────────────────────────────
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW=60

# ── Vector Store ─────────────────────────────────────────
# Use /tmp for ephemeral cloud hosts (data lost on restart)
# Use a mounted volume path for persistent storage
VECTOR_STORE_PATH=/tmp/vector_store
